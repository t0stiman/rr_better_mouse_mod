<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
    <PackageId>better_mouse_mod</PackageId>
    <RootNamespace>better_mouse_mod</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Railroader -->
    <Reference Include="Railroader" />
    <Reference Include="Railroader.Modding" />

    <!-- Unity -->
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.InputLegacyModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
    

    <!-- others -->
    <Reference Include="KeyValue.Runtime" />
    <Reference Include="KinematicCharacterController" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Railroader" />
  </ItemGroup>

</Project>

